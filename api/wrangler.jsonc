{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marea-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Evalúa todas las zonas cada 15 minutos.
  "triggers": { "crons": ["*/15 * * * *"] },

  // D1 es opcional en el sentido de que la API sigue calculando en vivo sin
  // esto — pero con esto, los reportes ciudadanos alimentan la obstrucción.
  "d1_databases": [
    { "binding": "DB", "database_name": "marea", "database_id": "1d3a5d2e-15f6-4d1b-8fb1-aa27dc3a6f07" }
  ],

  // Clasificador de severidad de canal desde foto (api/src/adapters/vision.ts).
  "ai": { "binding": "AI" },

  // Historial de fotos de reportes. Requiere activar R2 en el dashboard
  // primero (Cloudflare lo exige, sin bypass por API) — luego:
  //   npx wrangler r2 bucket create marea-reportes
  // y descomentar. Sin esto, /api/reportes sigue funcionando igual, solo
  // no archiva la imagen.
  // "r2_buckets": [
  //   { "binding": "REPORTES", "bucket_name": "marea-reportes" }
  // ],

  "vars": {
    "TEMPORADA": "alta"
    // FONTUMI_LOCATION_ID: "5j8a0AZYowKVN0yOJscX" — descomentar cuando se
    // retome Fontumi (junto con el secret FONTUMI_TOKEN vía wrangler secret put).
  }
}
